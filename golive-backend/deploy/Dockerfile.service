# syntax=docker/dockerfile:1

FROM golang:1.26-alpine AS build

WORKDIR /src
RUN apk add --no-cache ca-certificates tzdata

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
ARG SERVICE
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" \
    -o /out/golive-service ./app/${SERVICE}/cmd

# alpine:3.20 stopped receiving security fixes in April 2026.
FROM alpine:3.22

# The services run as this fixed non-root UID/GID. The init-permissions job
# in docker-compose.yml gives it the upload/recording volumes and read access
# to deploy/secrets; change the IDs there as well if you change them here.
RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S -g 10001 golive \
 && adduser -S -D -H -u 10001 -G golive -h /app -s /sbin/nologin golive
WORKDIR /app
COPY --from=build /out/golive-service /usr/local/bin/golive-service
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/golive-service"]
