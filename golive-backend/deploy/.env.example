# Copy this file to .env on the server and fill in real values there.
# Docker Compose reads golive-backend/deploy/.env when started from this folder.

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# Existing replay provider, optional.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
