#!/usr/bin/env bash
set -Eeuo pipefail

# Install this file as:
#   /srv/git/golive.git/hooks/post-receive
#
# It checks out the pushed branch into WORK_TREE, builds the Vite frontend
# with a China-friendly npm mirror, rebuilds service images, then updates the
# Docker Compose stack.

APP_NAME="golive"
WORK_TREE="${WORK_TREE:-/srv/${APP_NAME}/app}"
DEPLOY_BRANCH="${DEPLOY_BRANCH:-main}"
FALLBACK_BRANCH="${FALLBACK_BRANCH:-master}"
GIT_DIR="${GIT_DIR:-/srv/git/${APP_NAME}.git}"
# `docker compose up` waits for health checks with no limit of its own, so a
# service that keeps crashing at startup would hang the push. Give up after
# this long (GNU timeout syntax).
UP_TIMEOUT="${UP_TIMEOUT:-20m}"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# reconcile_mounted_config force-recreates a Compose service when the config
# file it bind-mounts no longer matches the freshly checked-out file on disk.
#
# Why this is needed: services like nginx and srs mount a SINGLE file
# (e.g. ./nginx.https.conf:/etc/nginx/nginx.https.conf). Docker binds that
# mount by inode at container-creation time. `git checkout -f` writes configs
# atomically (temp file + rename), producing a NEW inode, so a long-running
# container keeps serving the OLD file content. `docker compose up -d` will
# not recreate the container because the Compose service definition itself did
# not change, and `nginx -s reload` cannot help because the mounted file is
# still the stale inode. Only recreating the container re-resolves the path to
# the current inode. We compare content hashes so this self-heals on every
# deploy regardless of git history.
#
#   $1 service   Compose service name (also the container suffix golive-<svc>)
#   $2..$n       pairs of <host_file_relative_to_deploy_dir> <container_path>
reconcile_mounted_config() {
  local service="$1"; shift
  local container="${APP_NAME}-${service}"
  local needs_recreate=0

  while (($# >= 2)); do
    local host_file="$1" container_path="$2"; shift 2
    [[ -f "$host_file" ]] || continue
    local host_sum cont_sum
    host_sum="$(sha256sum < "$host_file" | awk '{print $1}')"
    # Hash the container's copy on the host side (only needs `cat` inside the
    # container, which is more universally present than sha256sum). If the file
    # is unreadable/missing in the container, treat as drift and recreate.
    cont_sum="$(docker exec "$container" cat "$container_path" 2>/dev/null | sha256sum | awk '{print $1}')" || cont_sum=""
    if [[ -z "$cont_sum" || "$host_sum" != "$cont_sum" ]]; then
      log "config drift on ${service} (${container_path}); will recreate"
      needs_recreate=1
    fi
  done

  if ((needs_recreate)); then
    docker compose up -d --force-recreate --no-deps "$service"
  fi
}

# remove_disabled_kafka removes the golive-kafka container when the "kafka"
# Compose profile is not enabled (COMPOSE_PROFILES in deploy/.env).
# Containers of profile-disabled services are not orphans, so
# `--remove-orphans` leaves them running; this is what retires the old
# ZooKeeper-based broker, whose ZooKeeper container is gone.
remove_disabled_kafka() {
  local services
  services="$(docker compose config --services)"
  if grep -qx kafka <<<"$services"; then
    return 0
  fi
  if docker container inspect golive-kafka >/dev/null 2>&1; then
    log "kafka profile is off; removing container golive-kafka"
    docker rm -f golive-kafka >/dev/null
  fi
}

deploy_ref() {
  local newrev="$1"
  local ref="$2"
  local deleted="0000000000000000000000000000000000000000"

  if [[ "$newrev" == "$deleted" ]]; then
    log "skip ${ref}; branch was deleted"
    return 0
  fi

  local branch="${ref#refs/heads/}"

  if [[ "$branch" != "$DEPLOY_BRANCH" && "$branch" != "$FALLBACK_BRANCH" ]]; then
    log "skip ${ref}; deploy branch is ${DEPLOY_BRANCH} or ${FALLBACK_BRANCH}"
    return 0
  fi

  log "deploying ${branch} to ${WORK_TREE}"
  mkdir -p "$WORK_TREE"
  git --work-tree="$WORK_TREE" --git-dir="$GIT_DIR" checkout -f "$branch"

  log "building frontend"
  docker run --rm \
    -v "${WORK_TREE}/golive-web:/app" \
    -w /app \
    node:20-alpine \
    sh -lc 'corepack enable && pnpm config set registry https://registry.npmmirror.com && pnpm install --frozen-lockfile && pnpm build'

  cd "${WORK_TREE}/golive-backend/deploy"
  log "building service images"
  docker compose build

  remove_disabled_kafka

  # init-permissions runs first; services start once their dependencies are
  # healthy (see docker-compose.yml).
  log "starting services (gives up after ${UP_TIMEOUT})"
  if ! timeout "$UP_TIMEOUT" docker compose up -d --remove-orphans; then
    log "docker compose up failed or timed out; check: docker compose ps -a; docker compose logs --tail=100 <service>"
    docker compose ps -a || true
    exit 1
  fi

  # Heal single-file bind-mount drift for edge containers (see helper comment).
  # nginx serves whichever config its entrypoint picked; both are mounted, so
  # compare both. srs.conf changing forces an srs recreate (briefly interrupts
  # the live stream, but only when srs.conf actually changed).
  log "reconciling edge config mounts"
  reconcile_mounted_config nginx \
    nginx.conf /etc/nginx/nginx.http.conf \
    nginx.https.conf /etc/nginx/nginx.https.conf \
    security-headers.conf /etc/nginx/security-headers.conf
  reconcile_mounted_config srs \
    srs.conf /usr/local/srs/conf/srs.conf

  log "current service status"
  docker compose ps -a
}

while read -r oldrev newrev refname; do
  deploy_ref "$newrev" "$refname"
done
